<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebApp.Tests" />
    <InternalsVisibleTo Include="EventApi.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApp.Domain\WebApp.Domain.csproj" />
    <ProjectReference Include="..\WebApp.Application\WebApp.Application.csproj" />
    <ProjectReference Include="..\WebApp.Infrastructure\WebApp.Infrastructure.csproj" />
  </ItemGroup>

  <!-- XML Application для описаний DTO в Swagger -->
  <Target Name="CopyApplicationXml" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\WebApp.Application\bin\$(Configuration)\$(TargetFramework)\WebApp.Application.xml" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildThisFileDirectory)..\WebApp.Application\bin\$(Configuration)\$(TargetFramework)\WebApp.Application.xml')" />
  </Target>

</Project>
